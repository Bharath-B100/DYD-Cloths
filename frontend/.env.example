# Leave blank for local Vite development. Firebase then uses the project's
# firebaseapp.com auth domain, which is safe for localhost and 127.0.0.1.
#
# For each deployed app, set this to its exact public hostname (without a
# protocol or path), after authorizing that host in Firebase Auth and Google
# OAuth. It must be the host that serves /__/auth through the backend proxy.
# Example: dyd-cloths.onrender.com
VITE_FIREBASE_AUTH_DOMAIN=
