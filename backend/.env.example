NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tshirt-business
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set TRUST_PROXY=1 only behind one trusted reverse proxy.
TRUST_PROXY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REMOVE_BG_API_KEY=
# Password recovery requires SMTP and PUBLIC_SITE_URL. No test emails are sent by the test suite.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Used only by npm run create-admin. Existing accounts are never overwritten.
ADMIN_EMAIL=
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=
# Destructive demo/reset scripts require yes and are always blocked in production.
ALLOW_DATABASE_RESET=no
