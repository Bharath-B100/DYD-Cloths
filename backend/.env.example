NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tshirt-business
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set TRUST_PROXY=1 only behind one trusted reverse proxy.
TRUST_PROXY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REMOVE_BG_API_KEY=

# Used only by npm run create-admin. Existing accounts are never overwritten.
ADMIN_EMAIL=
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=
# Destructive demo/reset scripts require yes and are always blocked in production.
ALLOW_DATABASE_RESET=no

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# IMPORTANT FOR RENDER HOSTING:
# Render Free Tier BLOCKS outbound SMTP ports (25, 465, 587).
# On localhost, standard SMTP works. On Render Free, you MUST use an HTTPS-based
# provider (Resend, Brevo, or Gmail REST API) which send over port 443 (never blocked).
# If you upgrade to a paid Render plan, SMTP ports are unblocked.

# Option 1: Resend (Recommended for Render Free - 3,000 emails/month free)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=DYD-Clothes <onboarding@resend.dev>

# Option 2: Brevo HTTP API (300 emails/day free - sends over HTTPS port 443)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER=dydclothes.admin@gmail.com

# Option 3: Localhost SMTP (or Render Paid plans)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM="DYD-Clothes <dydclothes.admin@gmail.com>"
SMTP_USER=dydclothes.admin@gmail.com
SMTP_PASSWORD=

# Option 4: Gmail REST API over HTTPS (Requires Google Cloud Console OAuth2)
# EMAIL_PROVIDER=gmail
# GMAIL_SENDER=dydclothes.admin@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
